OPENAI_API_KEY=placeholder
ELEVENLABS_API_KEY=placeholder
DEEPGRAM_API_KEY=placeholder
TWILIO_ACCOUNT_SID=placeholder
TWILIO_AUTH_TOKEN=placeholder
PORT=3000

# ASR provider: "elevenlabs" or "deepgram"
ASR_PROVIDER=elevenlabs

# Interruptions: "true" (default) or "false"
# Can be toggled at runtime via POST /interruptions
INTERRUPTIONS_ENABLED=true

# Logging: DEBUG | INFO | WARN | ERROR | FATAL
LOG_LEVEL=DEBUG

# File logging: "true" (default) or "false"
LOG_TO_FILE=true
