{
	"info": {
		"_postman_id": "86078930-7894-4407-a8a2-916b1cec0d02",
		"name": "Voice AI Platform",
		"description": "Collection for testing and monitoring the Voice AI Agent platform, including Twilio webhooks, Dashboard APIs, and Chat Simulation.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Telephony (Twilio)",
			"item": [
				{
					"name": "Incoming Webhook",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "From",
									"value": "+1234567890",
									"type": "text"
								},
								{
									"key": "To",
									"value": "+0987654321",
									"type": "text"
								},
								{
									"key": "CallSid",
									"value": "CA{{$guid}}",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/incoming",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"incoming"
							]
						},
						"description": "Simulate an incoming call from Twilio. Returns TwiML with the WebSocket URL."
					},
					"response": []
				}
			]
		},
		{
			"name": "Dashboard APIs",
			"item": [
				{
					"name": "Get Call History",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/history",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"history"
							]
						},
						"description": "Fetch the history of recent calls and their session state."
					},
					"response": []
				},
				{
					"name": "Get Call Events (SSE)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "text/event-stream",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/events/{{callId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"events",
								"{{callId}}"
							]
						},
						"description": "Server-Sent Events endpoint for real-time log updates for a specific call."
					},
					"response": []
				},
				{
					"name": "Toggle Global Interruptions",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"enabled\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/interruptions",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"interruptions"
							]
						},
						"description": "Enable or disable interruptions for all active calls."
					},
					"response": []
				},
				{
					"name": "Toggle Call Interruption",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"enabled\": false\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/interruptions/{{callId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"interruptions",
								"{{callId}}"
							]
						},
						"description": "Enable or disable interruptions for a specific call ID."
					},
					"response": []
				}
			]
		},
		{
			"name": "Simulation",
			"item": [
				{
					"name": "Agent Chat",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"text\": \"Namaste, my name is Rahul\",\n    \"callId\": \"{{callId}}\",\n    \"callerPhone\": \"+919876543210\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/chat",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"chat"
							]
						},
						"description": "Test the LLM agent workflow without audio/telephony. Set callId to empty for a new session."
					},
					"response": []
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5050",
			"type": "string"
		},
		{
			"key": "callId",
			"value": "test-call-id",
			"type": "string"
		}
	]
}